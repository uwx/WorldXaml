<TemplatedControl
    xmlns="https://github.com/uwx/worldxaml"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    x:Class="WorldXaml.UI.Yoga.HStack"
    AlignItems="Center"
    FlexDirection="Column">
    <TemplatedControl.Template>
        <ControlTemplate TargetType="HStack">
            <Box FlexDirection="{Binding BoxFlexDirection, RelativeSource={RelativeSource TemplatedParent}}"
                 AlignItems="Center" GapColumn="{Binding GapColumn, RelativeSource={RelativeSource TemplatedParent}}"
                 GapRow="{Binding GapRow, RelativeSource={RelativeSource TemplatedParent}}">
                <ContentPresenter />
            </Box>
        </ControlTemplate>
    </TemplatedControl.Template>
</TemplatedControl>